# Copy to .env (git-ignored) and pass it at build/run time:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
# No .env file is bundled into the app; every key is optional and has a safe
# default (see lib/core/config/env.dart). Never commit real secrets.
API_URL=http://127.0.0.1:3000
FRONTEND_URL=http://localhost:4200
BACKEND_URL=
API_BASE_URL=
APP_SCHEME=farm
APP_HOST=farm.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
