{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "farmapp-e2145",
          "appId": "1:1093041322989:android:5b521ac48fdb8c2f5385e4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "farmapp-e2145",
          "configurations": {
            "android": "1:1093041322989:android:5b521ac48fdb8c2f5385e4",
            "ios": "1:1093041322989:ios:b8418e7e0108bc375385e4",
            "macos": "1:1093041322989:ios:e34fa55ef34ff4545385e4",
            "web": "1:1093041322989:web:41a45717a36b1b165385e4",
            "windows": "1:1093041322989:web:b6d86e682dc2f9b85385e4"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/qr-checkout.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/checkout/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/pay/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/pay/success",
        "destination": "/index.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/qr-checkout.html"
      },
      {
        "source": "/pay/**",
        "destination": "/qr-checkout.html"
      },
      {
        "source": "/merchant-payment/**",
        "destination": "/qr-checkout.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
